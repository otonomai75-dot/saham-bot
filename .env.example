# ─── TELEGRAM (WAJIB) ────────────────────────────────────
# Dapatkan dari @BotFather di Telegram
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID tujuan (personal/grup). Cek pakai @userinfobot
CHAT_ID=123456789

# ─── SCHEDULE (OPSIONAL) ─────────────────────────────────
